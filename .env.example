# =============================================================================
# Javiator Environment Configuration Template
# =============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your hosting provider (e.g., Render / Vercel). Never commit `.env`.

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Comma-separated frontend origins allowed for CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# Option 1 (Cloud / Render / Neon): single connection URL (takes precedence)
# DATABASE_URL=postgresql://user:password@host:5432/javiator?sslmode=require

# Option 2 (Local Docker Compose): individual parameters
POSTGRES_DB=javiator
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Django Channels + Celery Broker)
# -----------------------------------------------------------------------------
# Single URL used by both Channels and Celery when set:
# REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Optional: set to "memory" for single-instance free-tier demo or unit tests
# without Redis. Defaults to "redis".
CHANNEL_LAYER_BACKEND=redis

# -----------------------------------------------------------------------------
# Dispatch, Simulation & Free-Tier Demo Mode
# -----------------------------------------------------------------------------
# Set True on single-service free tiers (e.g., Render Free Web Service without
# paid Celery workers) to run inline dispatch on order creation.
FREE_TIER_DEMO_MODE=False
# Optional: set True to allow straight-line interpolated fallback routes when
# ORS_API_KEY is absent or OpenRouteService is unreachable.
ALLOW_SYNTHETIC_ROUTE_FALLBACK=False
# Celery Beat intervals (seconds) when running full Docker Compose stack
TRACKING_TICK_INTERVAL_SECONDS=5.0
AUTO_DISPATCH_INTERVAL_SECONDS=30.0

# -----------------------------------------------------------------------------
# External Routing Provider (OpenRouteService)
# -----------------------------------------------------------------------------
ORS_API_KEY=replace-with-your-openrouteservice-api-key

# -----------------------------------------------------------------------------
# Next.js Frontend (javiator-ui/.env.local or hosting build env)
# -----------------------------------------------------------------------------
# Public backend URLs inlined at Next.js build time
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional; if omitted, derived automatically from NEXT_PUBLIC_API_URL (ws/wss)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# Optional Carto basemap key
NEXT_PUBLIC_CARTO_API_KEY=
