```gitignore
# ==============================
# Python
# ==============================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/

# ==============================
# Django
# ==============================
db.sqlite3
db.sqlite3-journal
*.sqlite3
staticfiles/
backend/staticfiles/
backend/media/

# ==============================
# Environment variables and secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Node.js / Next.js
# ==============================
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Testing and coverage
# ==============================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==============================
# Linters and type checkers
# ==============================
.mypy_cache/
.ruff_cache/
.pyright/

# ==============================
# IDEs and editors
# ==============================
.vscode/
.idea/
*.swp
*.swo

# ==============================
# OS-generated files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.bak

# ==============================
# Celery runtime state
# ==============================
celerybeat-schedule
celerybeat-schedule.*
backend/celerybeat-schedule
backend/celerybeat-schedule.*

# ==============================
# Local environment and tooling
# ==============================
.python-version
```
